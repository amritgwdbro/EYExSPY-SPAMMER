local function animateWindow(frame, show)
	if show then
		frame.Visible = true
		frame.Size = UDim2.fromOffset(0, 0)
		TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(420, 390)}):Play()
	else
		local tween = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0, 0)})
		tween:Play()
		tween.Completed:Connect(function()
			frame.Visible = false
			frame.Size = UDim2.fromOffset(420, 390)
		end)
	end
end

